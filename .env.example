# SplitPay AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:8000

# Google Gemini API (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# PayPal Sandbox Credentials (Get from https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Database
DATABASE_URL=sqlite:///./splitpay.db
